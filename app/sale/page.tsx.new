import { getProducts } from 'lib/shopify';
import ProductGrid from 'components/grid/product-grid';
import CollectionPageHeader from 'components/layout/collection-page-header';

export const metadata = {
  title: 'Sale Items',
  description: 'Shop our sale items and special offers at discounted prices'
};

export default async function SalePage() {
  // Fetch products from Shopify - simplified query for testing
  const products = await getProducts({
    sortKey: 'PRICE',
    reverse: false
  });
  
  // Limit to a small number of products for testing
  const displayProducts = products.slice(0, 8);

  // Format the products to match the expected structure for ProductGrid
  const formattedProducts = displayProducts.map((item, index) => ({
    id: index + 1,
    title: item.title,
    handle: item.handle,
    discountPrice: parseFloat(item.priceRange.minVariantPrice.amount),
    price: parseFloat(item.priceRange.maxVariantPrice.amount),
    image: item.featuredImage?.url || '',
    tag: "Sale",
    badge: "Sale",
    ratings: 4,
    reviews: 40
  }));

  return (
    <div className="max-w-screen-2xl mx-auto px-4 sm:px-6 md:px-8 py-10">
      <CollectionPageHeader
        title="Sale Items"
        description="Shop our sale items and special offers at discounted prices"
        collectionName="Sale"
        itemCount={formattedProducts.length}
      />
      
      {formattedProducts.length > 0 ? (
        <ProductGrid products={formattedProducts} />
      ) : (
        <div className="text-center py-20">
          <h2 className="text-xl font-medium text-gray-600">No sale items available</h2>
          <p className="mt-2 text-gray-500">Please check back later for our promotions</p>
        </div>
      )}
    </div>
  );
}
